# DRDO ID26053 — Jetson AGX Orin Dockerfile
# Build (from repo root): docker build -f deploy/docker/Dockerfile.jetson -t drdo-nav:latest .
# Run:                    docker run --runtime nvidia --net host --ipc host --privileged -v /dev:/dev drdo-nav:latest
#
# !! UNRESOLVED BLOCKER (see SIH_Deep_Dive_Audit.md §2.4) !!
# l4t-pytorch:r35.2.1 is JetPack 5 = Ubuntu 20.04 (focal), CUDA 11.4. ROS 2 Humble apt packages are
# only published for Ubuntu 22.04 (jammy), so `apt-get install ros-humble-*` below cannot succeed on
# this base. Pick one before the demo and verify ON the Orin:
#   (a) JetPack 6 / L4T r36 (Ubuntu 22.04) base image + apt ROS 2 Humble   (recommended)
#   (b) stay on JetPack 5 and build ROS 2 Humble from source (slow, large image)
# Also not installed here yet: fast_lio and ouster-ros must be built from source into the colcon
# workspace; nvblox needs the Isaac ROS apt repo. Without them mapping.launch.py fails immediately.
FROM nvcr.io/nvidia/l4t-pytorch:r35.2.1-pth2.0-py3

ENV DEBIAN_FRONTEND=noninteractive

# 1. ROS 2 Humble (see blocker above)
RUN apt-get update && apt-get install -y \
    curl gnupg2 lsb-release software-properties-common && \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
    http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
    | tee /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y \
    ros-humble-ros-base \
    ros-humble-nav2-bringup \
    ros-humble-nav2-smac-planner \
    ros-humble-nav2-mppi-controller \
    ros-humble-tf2-ros \
    ros-humble-tf2-geometry-msgs \
    python3-colcon-common-extensions \
    python3-pip \
    cmake \
    g++ && \
    rm -rf /var/lib/apt/lists/*

# 2. Python dependencies. pybind11 comes from pip: the CMake build resolves it via
#    `python3 -m pybind11 --cmake`, which the apt pybind11-dev package does not provide.
RUN pip3 install --no-cache-dir \
    "numpy<2" \
    scipy \
    scikit-learn \
    pyyaml \
    onnx \
    pybind11 \
    pycuda

# 3. Workspace (.dockerignore keeps datasets, build outputs and IDE state out of the image)
WORKDIR /workspace
COPY . /workspace/sih/

# 4. C++ engine + pybind11 module (was: a phase3/ path that no longer exists)
RUN cd /workspace/sih && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build -j"$(nproc)" && \
    ./build/test_grid_engine && \
    cp build/drdo_map*.so lib/ && \
    pip3 install --no-cache-dir -e .

# 5. ROS 2 packages
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && \
    cd /workspace/sih/ros2 && \
    colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release --packages-select drdo_grid_map drdo_perception drdo_bringup"

ENV PYTHONPATH=/workspace/sih/lib:$PYTHONPATH

COPY deploy/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
